# Copy to .env.production in the repository root; keep this file out of git.
# Use ACTUAL existing credentials, not new ones. Single quotes prevent $ expansion.
POSTGRES_DB='REPLACE_WITH_EXISTING_DB'
POSTGRES_USER='REPLACE_WITH_EXISTING_USER'
POSTGRES_PASSWORD='REPLACE_WITH_EXISTING_PASSWORD'
# Copy the exact volume name from docker inspect. Do not create a new empty volume.
POSTGRES_VOLUME_NAME=REPLACE_WITH_EXISTING_VOLUME
POSTGRES_PORT=5432
FRONTEND_BIND_IP=0.0.0.0
FRONTEND_PORT=8080
SHIFT_ALLOWED_ORIGINS=https://platbase-tooltech.xvps.jp
SHIFT_ALLOWED_HOSTS=platbase-tooltech.xvps.jp,backend,localhost,127.0.0.1
