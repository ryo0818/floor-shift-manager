# Copy to .env. Loaded automatically by the API and management commands.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=floor_shift
PGUSER=floor_shift
PGPASSWORD=replace-with-your-database-password
# DATABASE_URL may be used instead of the PG* settings above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
SHIFT_SECURE_COOKIE=false
SHIFT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
SHIFT_ALLOWED_HOSTS=localhost,127.0.0.1
